{
    "name": "docuccino/docuccino",
    "description": "UIR-based API documentation generator for Laravel (monorepo).",
    "type": "project",
    "keywords": [
        "openapi",
        "api-documentation",
        "laravel",
        "uir",
        "swagger",
        "scramble-alternative"
    ],
    "homepage": "https://docuccino.app",
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Martin"
        }
    ],
    "support": {
        "issues": "https://github.com/docuccino/docuccino/issues",
        "source": "https://github.com/docuccino/docuccino"
    },
    "require": {
        "php": "^8.3",
        "docuccino/core": "self.version",
        "docuccino/attributes": "self.version",
        "docuccino/inference-phpstan": "self.version",
        "docuccino/laravel": "self.version"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/passport": "^12.0 || ^13.0",
        "laravel/pint": "^1.19",
        "laravel/sanctum": "^4.0",
        "lorisleiva/laravel-actions": "^2.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpdoc-parser": "^2",
        "phpstan/phpstan": "^2.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-json-api-paginate": "^2.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-query-builder": "^7.0",
        "timacdonald/json-api": "^1.0@beta"
    },
    "repositories": [
        {
            "type": "path",
            "url": "php/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Docuccino\\Core\\Tests\\": "php/core/tests/",
            "Docuccino\\Inference\\PhpStan\\Tests\\": "php/inference-phpstan/tests/",
            "Docuccino\\Laravel\\Tests\\": "php/laravel/tests/",
            "Workbench\\App\\": "php/laravel/workbench/app/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "process-timeout": 1800,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "changelog": "@php tools/changelog.php",
        "lint:pr-title": "@php tools/pr-title-lint.php",
        "test": [
            "@php tools/fixture-app-drift.php",
            "pest --parallel"
        ],
        "test:unit": [
            "@php tools/fixture-app-drift.php",
            "pest --parallel --exclude-group=fixture"
        ],
        "test:inference-fixture": [
            "@php tools/fixture-app-drift.php",
            "pest --parallel --group=fixture"
        ],
        "test:coverage": [
            "@php -r \"@mkdir('build', 0755, true);\"",
            "pest --parallel --coverage-clover=build/clover.xml --exclude-group=fixture",
            "@php tools/coverage-floors.php build/clover.xml"
        ],
        "test:types": "@php -d grpc.enable_fork_support=1 vendor/bin/pest --type-coverage --exclude-group=fixture --min=100 --memory-limit=2G",
        "analyse": "phpstan analyse --no-progress --memory-limit=2G",
        "lint": "pint --test",
        "fix": "pint",
        "sync-schema": "@php -r \"@mkdir('php/core/resources/spec/uir/1.0', 0755, true); copy('spec/uir/1.0/schema.json', 'php/core/resources/spec/uir/1.0/schema.json') or exit(1); echo 'Synced spec/uir/1.0/schema.json -> php/core/resources/spec/uir/1.0/schema.json'.PHP_EOL;\""
    }
}
