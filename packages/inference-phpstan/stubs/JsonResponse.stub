<?php

namespace Illuminate\Http;

/**
 * Docuccino stub: give JsonResponse a payload type parameter (and a folded HTTP
 * status parameter) so the shape and status recovered by
 * ResponseJsonReturnTypeExtension have somewhere to live. Pairs with that
 * extension (design §7). Shipped in the generated neon's `stubFiles`.
 *
 * `TStatus` carries the constant-folded response status when it is statically
 * known (`response()->json($x, 201)` → `JsonResponse<TPayload, 201>`); it
 * defaults to `200` at the call site. The pipeline unwraps both parameters,
 * mapping the payload shape under the folded status.
 *
 * @template TPayload
 * @template TStatus of int
 */
class JsonResponse extends \Symfony\Component\HttpFoundation\JsonResponse
{
}
