{
    "name": "docuccino/laravel",
    "description": "Laravel adapter for Docuccino: route discovery, extension registry, pipeline and artisan export.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "docuccino/core": "*",
        "docuccino/attributes": "*",
        "docuccino/inference-phpstan": "*",
        "phpstan/phpdoc-parser": "^2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "larastan/larastan": "^3.10",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Docuccino\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Docuccino\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\": "workbench/database/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Docuccino\\Laravel\\DocuccinoServiceProvider"
            ],
            "aliases": {
                "Docuccino": "Docuccino\\Laravel\\Facades\\Docuccino"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
