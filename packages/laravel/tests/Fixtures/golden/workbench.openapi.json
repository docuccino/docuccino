{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.2/dialect/base",
  "info": {
    "title": "API Documentation",
    "version": "1.0.0"
  },
  "paths": {
    "/api/archived-forms/{form}": {
      "get": {
        "summary": "Show a form.",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "form",
            "in": "path",
            "description": "Resolves soft-deleted (trashed) records as well as active ones.",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormData"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/article-resources": {
      "get": {
        "summary": "An anonymous resource collection → array of the item schema.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ArticleResource"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/article-resources/{id}": {
      "get": {
        "summary": "A single API resource whose whenLoaded fields become optional.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleResource"
                }
              }
            }
          }
        }
      }
    },
    "/api/articles": {
      "post": {
        "summary": "Spatie Data request (body from the Data class) + response, under a folded 201.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "author": {},
                  "body": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "heading": {
                    "type": "string"
                  },
                  "id": {
                    "type": "integer"
                  },
                  "internal": {
                    "type": "integer"
                  },
                  "secret": {
                    "type": "string"
                  },
                  "subtitle": {}
                },
                "required": [
                  "id",
                  "heading",
                  "body",
                  "secret",
                  "internal",
                  "author"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            }
          }
        }
      }
    },
    "/api/broken": {
      "get": {
        "description": "Documentation could not be generated for this route."
      }
    },
    "/api/forms": {
      "get": {
        "summary": "List forms.",
        "description": "Returns the collection of forms visible to the caller.",
        "tags": [
          "Forms"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FormData"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/forms/{form}": {
      "get": {
        "summary": "Show a form.",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "form",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormData"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/jsonapi-articles/{id}": {
      "get": {
        "summary": "A first-party JSON:API resource → JSON:API document + include/fields query params.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Sparse fieldsets per resource type (fields[TYPE]=field1,field2).",
            "required": false,
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "Comma-separated list of relationships to include as compound-document data.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleJsonApiResource"
                }
              }
            }
          }
        }
      }
    },
    "/api/model-widgets/{id}": {
      "get": {
        "summary": "An Eloquent model → object schema from columns + casts + visible/hidden.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "A 204 No Content response (noContent()).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/moderated-forms": {
      "get": {
        "summary": "List forms.",
        "description": "Returns the collection of forms visible to the caller.",
        "tags": [
          "Forms"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FormData"
                  }
                }
              }
            }
          }
        },
        "x-permissions": [
          {
            "type": "permission",
            "values": [
              "moderate forms"
            ],
            "guard": "web"
          }
        ]
      }
    },
    "/api/ping": {
      "get": {}
    },
    "/api/rate-limited": {
      "get": {
        "summary": "List forms.",
        "description": "Returns the collection of forms visible to the caller.",
        "tags": [
          "Forms"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FormData"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests — the rate limit for this endpoint has been exceeded.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before making another request.",
                "schema": {
                  "type": "integer",
                  "example": 60
                }
              },
              "X-RateLimit-Limit": {
                "description": "The maximum number of requests permitted in the current window.",
                "schema": {
                  "type": "integer",
                  "example": 60
                }
              },
              "X-RateLimit-Remaining": {
                "description": "The number of requests remaining in the current window.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "post": {
        "summary": "Distinct return paths carrying distinct statuses (200 + 202).",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "accepted"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/tickets": {
      "post": {
        "tags": [
          "Widgets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "avatar": {
                    "description": "An image file.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "binary"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "user"
                    ]
                  }
                },
                "required": [
                  "name",
                  "quantity",
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created widget.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetData"
                }
              }
            }
          }
        }
      }
    },
    "/api/widget-query": {
      "get": {
        "summary": "List forms, filterable and sortable via the query string.",
        "parameters": [
          {
            "name": "filter[name]",
            "in": "query",
            "description": "Partial-match filter",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[status]",
            "in": "query",
            "description": "Exact-match filter",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Items per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort by: name, created_at (prefix `-` for descending).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "name"
            }
          }
        ]
      }
    },
    "/api/widgets": {
      "post": {
        "summary": "Create a widget.",
        "tags": [
          "Widgets"
        ],
        "security": [],
        "parameters": [
          {
            "name": "dry_run",
            "in": "query",
            "description": "Validate without persisting.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The created widget.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetData"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Article": {
        "type": "object",
        "properties": {
          "author": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthorData"
              },
              {
                "type": "null"
              }
            ]
          },
          "body": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "subtitle": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "headline",
          "body"
        ]
      },
      "ArticleJsonApiResource": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "attributes": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "body"
                ]
              },
              "id": {
                "type": "string"
              },
              "links": {
                "type": "object",
                "properties": {
                  "self": {
                    "type": "string"
                  }
                },
                "required": [
                  "self"
                ]
              },
              "relationships": {
                "type": "object",
                "properties": {
                  "author": {
                    "type": "string"
                  }
                },
                "required": [
                  "author"
                ]
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "type"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "ArticleResource": {
        "type": "object",
        "properties": {
          "author": {
            "$ref": "#/components/schemas/AuthorResource"
          },
          "excerpt": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "AuthorData": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "AuthorResource": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "FormData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "Widget": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {},
          "id": {
            "type": "integer"
          },
          "is_active": {
            "type": "boolean"
          },
          "meta": {
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "x-enumDescriptions": {
              "draft": "Not yet visible to applicants.",
              "published": "Live and accepting traffic."
            }
          }
        },
        "required": [
          "id",
          "name",
          "is_active",
          "status",
          "meta"
        ]
      },
      "WidgetData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "x-enumDescriptions": {
              "draft": "Not yet visible to applicants.",
              "published": "Live and accepting traffic."
            }
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ]
      }
    }
  }
}
