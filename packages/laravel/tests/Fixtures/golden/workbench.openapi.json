{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.2/dialect/base",
  "info": {
    "title": "API Documentation",
    "version": "1.0.0"
  },
  "paths": {
    "/api/broken": {
      "get": {
        "description": "Documentation could not be generated for this route."
      }
    },
    "/api/forms": {
      "get": {
        "summary": "List forms.",
        "description": "Returns the collection of forms visible to the caller.",
        "tags": [
          "Forms"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FormData"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/forms/{form}": {
      "get": {
        "summary": "Show a form.",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "form",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormData"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ping": {
      "get": {}
    },
    "/api/widgets": {
      "post": {
        "summary": "Create a widget.",
        "tags": [
          "Widgets"
        ],
        "security": [],
        "parameters": [
          {
            "name": "dry_run",
            "in": "query",
            "description": "Validate without persisting.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The created widget.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetData"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FormData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "WidgetData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  }
