<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="build/phpunit">
    <php>
        <!-- The inference suite boots PHPStan/Larastan in-process; the whole run accumulates past
             the 128M default (the `analyse` script raises the same limit for the same reason). The
             headroom above that is for the parallel COVERAGE merge, which is the one step that holds
             every worker's coverage at once: at 1G it died in `CoverageMerger::addCoverageFromFile`
             with the suite already green, so the cap read as "parallel coverage is unsupported". -->
        <ini name="memory_limit" value="4G"/>
    </php>
    <testsuites>
        <testsuite name="core">
            <directory>php/core/tests</directory>
        </testsuite>
        <testsuite name="inference">
            <directory>php/inference-phpstan/tests</directory>
        </testsuite>
        <testsuite name="attributes">
            <directory>php/attributes/tests</directory>
        </testsuite>
        <testsuite name="laravel">
            <directory>php/laravel/tests</directory>
        </testsuite>
        <!-- The repo's own scripts under tools/ — no package, so deliberately outside the
             <source> set below: they ship to nobody and carry no per-package coverage floor. -->
        <testsuite name="tools">
            <directory>tests/tools</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>php/core/src</directory>
            <directory>php/inference-phpstan/src</directory>
            <directory>php/laravel/src</directory>
        </include>
    </source>
</phpunit>
