<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="build/phpunit">
    <php>
        <!-- The inference suite boots PHPStan/Larastan in-process; the whole run accumulates past
             the 128M default (the `analyse` script raises the same limit for the same reason). -->
        <ini name="memory_limit" value="1G"/>
    </php>
    <testsuites>
        <testsuite name="core">
            <directory>packages/core/tests</directory>
        </testsuite>
        <testsuite name="inference">
            <directory>packages/inference-phpstan/tests</directory>
        </testsuite>
        <testsuite name="attributes">
            <directory>packages/attributes/tests</directory>
        </testsuite>
        <testsuite name="laravel">
            <directory>packages/laravel/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/core/src</directory>
            <directory>packages/inference-phpstan/src</directory>
            <directory>packages/laravel/src</directory>
        </include>
    </source>
</phpunit>
