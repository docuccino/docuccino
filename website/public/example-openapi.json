{
  "openapi": "3.1.0",
  "info": {
    "title": "Invoices API",
    "version": "1.0.0",
    "description": "A small example API generated by Docuccino from a Laravel application — invoices and orders. This is the real shape Docuccino emits, rendered by the bundled Scalar viewer."
  },
  "servers": [
    { "url": "https://api.example.com" }
  ],
  "tags": [
    { "name": "Invoices", "description": "Create and browse invoices" },
    { "name": "Orders", "description": "Read orders" }
  ],
  "paths": {
    "/api/invoices": {
      "get": {
        "operationId": "invoices.index",
        "summary": "List invoices",
        "tags": ["Invoices"],
        "security": [{ "bearer": [] }],
        "parameters": [
          {
            "name": "filter[status]",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/InvoiceStatus" }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 15, "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of invoices",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedInvoices" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      },
      "post": {
        "operationId": "invoices.store",
        "summary": "Create an invoice",
        "tags": ["Invoices"],
        "security": [{ "bearer": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": { "type": "integer" },
                  "currency": { "type": "string", "enum": ["GBP", "USD", "EUR"] },
                  "due_at": { "type": ["string", "null"], "format": "date" }
                },
                "required": ["customer_id", "currency"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created invoice",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Invoice" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/invoices/{invoice}": {
      "get": {
        "operationId": "invoices.show",
        "summary": "Show an invoice",
        "tags": ["Invoices"],
        "security": [{ "bearer": [] }],
        "parameters": [
          {
            "name": "invoice",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "The invoice",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Invoice" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/orders": {
      "get": {
        "operationId": "orders.index",
        "summary": "List orders",
        "tags": ["Orders"],
        "security": [{ "bearer": [] }],
        "responses": {
          "200": {
            "description": "A list of orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Order" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "InvoiceStatus": {
        "type": "string",
        "enum": ["draft", "sent", "paid"],
        "x-enumDescriptions": {
          "draft": "Created but not yet sent to the customer",
          "sent": "Sent and awaiting payment",
          "paid": "Paid in full"
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "customer_id": { "type": "integer" },
          "currency": { "type": "string" },
          "total": { "type": "number" },
          "status": { "$ref": "#/components/schemas/InvoiceStatus" },
          "due_at": { "type": ["string", "null"], "format": "date" }
        },
        "required": ["id", "customer_id", "currency", "total", "status"]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "reference": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "shipped", "closed"] },
          "total": { "type": "number" }
        },
        "required": ["id", "reference", "status", "total"]
      },
      "PaginatedInvoices": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Invoice" }
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": { "type": "integer" },
              "per_page": { "type": "integer" },
              "total": { "type": "integer" }
            }
          }
        },
        "required": ["data"]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" }
        }
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "Unauthenticated",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": { "message": { "type": "string" } }
            }
          }
        }
      },
      "NotFound": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": { "message": { "type": "string" } }
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": { "type": "string" },
                "errors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
